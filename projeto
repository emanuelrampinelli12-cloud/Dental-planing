  second=await other.new_page()
  await second.goto(BASE+'/login')
  await second.locator('input[name=email]').fill(email)
  await second.locator('input[name=password]').fill(password)
  await second.get_by_role('button',name='Entrar no consultório').click()
  await second.wait_for_url(BASE+'/',timeout=30000)
  response=await other.request.patch(BASE+'/api/patients/'+patient_id,data={})
  assert response.status==404
  print('PASS: acesso anônimo bloqueado e isolamento entre contas')
  mobile=await browser.new_context(viewport={'width':390,'height':844})
  mobilepage=await mobile.new_page()
  for route in ['/','/demo','/patients','/prices','/resgata']:
   await mobilepage.goto(BASE+route)
   await mobilepage.wait_for_load_state('networkidle')
   overflow=await mobilepage.evaluate('document.documentElement.scrollWidth>window.innerWidth')
   assert not overflow,f'Overflow mobile {route}'
  print('PASS: rotas principais sem transbordamento em 390 px')
  assert not errors,errors
  print('PASS: sem erros JavaScript durante o fluxo')
  (OUT/'result.json').write_text(json.dumps({'status':'PASS','patientId':patient_id,'marks':4,'pdfPages':len(doc),'errors':errors}))
  await browser.close()
asyncio.run(main())

